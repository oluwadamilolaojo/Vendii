# "mock" (default) keeps all data in the browser, no backend needed.
# "firebase" uses Firebase Auth, Firestore and Storage, as described in README.md.
NEXT_PUBLIC_DATA_SOURCE=mock

# Firebase console > Project settings > General > Your apps > Web app. Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Usually <project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Firebase console > Project settings > Service accounts > Generate new private key.
# Copy the three fields from the downloaded JSON. Keep the private key on one line with \n in it.
# Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mock mode only: emails that sign in as Dividendi ops staff (comma separated).
NEXT_PUBLIC_OPS_EMAILS=ops@dividendi.ng
